					"fontSize": "var(--wp--preset--font-size--h-3)",
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.9375rem",
					"fontWeight": "600",
					"lineHeight": "1"
				},
				"border": {
					"radius": "6px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)",
						"text": "var(--wp--preset--color--on-accent)"
					}
				}
			}
