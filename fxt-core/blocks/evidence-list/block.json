{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fxt/evidence-list",
	"title": "Test evidence index",
	"category": "fxt",
	"icon": "list-view",
	"description": "Published test evidence and tests still in progress.",
	"textdomain": "fxt-core",
	"supports": {
		"html": false,
		"align": [
			"wide"
		]
	},
	"editorScript": "fxt-core-blocks",
	"render": "file:./render.php",
	"attributes": {
		"scope": {
			"type": "string",
			"enum": [
				"all",
				"country"
			],
			"default": "all"
		},
		"showPending": {
			"type": "boolean",
			"default": true
		},
		"publishedTitle": {
			"type": "string",
			"default": ""
		},
		"pendingTitle": {
			"type": "string",
			"default": ""
		}
	},
	"viewScript": "fxt-core-country"
}
