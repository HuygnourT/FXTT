{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fxt/source-label",
	"title": "Source label",
	"category": "fxt",
	"icon": "tag",
	"description": "A line such as \"Source: Tested\" with one of the site's source labels (Tested, Verified at source, Broker-stated, Not tested / Not verified), a note and links. Several labels per line (1.4.8), each with its own source type (or a custom one), name, link, text before and after, and show / hide.",
	"textdomain": "fxt-core",
	"attributes": {
		"kind": { "type": "string", "enum": [ "tested", "verified", "stated", "unverified" ], "default": "tested" },
		"text": { "type": "string", "default": "" },
		"prefix": { "type": "string", "default": "Source:" },
		"note": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "" },
		"newTab": { "type": "boolean", "default": false },
		"visibility": { "type": "string", "enum": [ "", "show", "hide" ], "default": "" },
		"labels": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"kind": { "type": "string" },
					"name": { "type": "string" },
					"url": { "type": "string" },
					"newTab": { "type": "boolean" },
					"before": { "type": "string" },
					"after": { "type": "string" },
					"hidden": { "type": "boolean" }
				}
			}
		}
	},
	"supports": { "html": false },
	"editorScript": "fxt-core-blocks",
	"render": "file:./render.php"
}
