{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fxt/source-label",
	"title": "Source label",
	"category": "fxt",
	"icon": "tag",
	"description": "A line such as \"Source: Tested\" with one of the site's source labels (Tested, Verified at source, Broker-stated, Not tested / Not verified), an optional note and an optional link.",
	"textdomain": "fxt-core",
	"attributes": {
		"kind": { "type": "string", "enum": [ "tested", "verified", "stated", "unverified" ], "default": "tested" },
		"text": { "type": "string", "default": "" },
		"prefix": { "type": "string", "default": "Source:" },
		"note": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "" },
		"newTab": { "type": "boolean", "default": false }
	},
	"supports": { "html": false },
	"editorScript": "fxt-core-blocks",
	"render": "file:./render.php"
}
